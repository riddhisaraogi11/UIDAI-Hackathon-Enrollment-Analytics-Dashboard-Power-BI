	partition 'Date Table' = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR (DATE(2025,1,1), DATE(2025,12,31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM")
				)
				
				```

